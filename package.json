{
  "name": "mcpa",
  "version": "1.0.0",
  "private": true,
  "engines": {"node": ">=22"},
  "scripts": {
    "start": "node scripts/start.mjs",
    "configure": "node scripts/configure.mjs",
    "doctor": "node scripts/configure.mjs doctor",
    "check": "node scripts/check.mjs",
    "test": "node scripts/test.mjs",
    "test:browser": "node tests/auth.browser.cjs",
    "test:auth": "node tests/auth.browser.cjs --auth",
    "test:recipient-db": "node --test --test-concurrency=1 tests/recipient-transfer.database.test.cjs",
    "test:recipient-ui": "node tests/isolation-check.cjs && node tests/auth.browser.cjs --recipient-ux",
    "test:php": "node --test --test-concurrency=1 tests/php-backend.test.mjs tests/php-connection.test.mjs",
    "test:render": "node --test --test-concurrency=1 tests/render-runtime.test.mjs tests/php-connection.test.mjs",
    "test:container": "node scripts/test-container.mjs",
    "bundle:pdf": "node scripts/bundle-pdf.mjs",
    "generate:consumables": "node scripts/generate-consumables.cjs",
    "verify": "npm run check && npm test && npm run test:browser && npm run test:auth"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@napi-rs/canvas": "0.1.80",
    "jsqr": "1.4.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "pdfjs-dist": "5.4.624",
    "qrcode": "1.5.4"
  }
}
